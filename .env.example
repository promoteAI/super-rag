# SeekDB / OceanBase
ROOT_PASSWORD=123456
SEEKDB_DATABASE=super_rag
MYSQL_HOST=127.0.0.1
MYSQL_PORT=2881
MYSQL_DB=super_rag
MYSQL_USER=root
MYSQL_PASSWORD=123456

# Object Store (RustFS / S3-compatible)
OBJECT_STORE_S3_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_S3_ACCESS_KEY=minioadmin
OBJECT_STORE_S3_SECRET_KEY=minioadmin
OBJECT_STORE_S3_BUCKET=super_rag
OBJECT_STORE_S3_USE_PATH_STYLE=true

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_PORT=7687

CACHE_ENABLED=false

# Docker volumes (optional; defaults to current directory)
# DOCKER_VOLUME_DIRECTORY=.